# Set by the hosting/database team when the database provider is selected.
DATABASE_URL=

# Generate a unique secret for each environment; do not commit real values.
AUTH_SECRET=

# Set true only when the production proxy overwrites and validates Host headers.
AUTH_TRUST_HOST=false

# Optional OIDC provider. All three values are required to enable SSO.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# This claim must contain one exact role id from the RBAC role list.
AUTH_OIDC_ROLE_CLAIM=role

# Email/password sign-in stays disabled until the database account repository is connected.
